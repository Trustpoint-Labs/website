---
import trustpointLogo from "../img/trustpoint_labs_logo.svg?url";
import trustpointFavicon from "../img/trustpoint_favicon.png?url";

import "@fontsource/open-sauce-one/400.css";
import "@fontsource/open-sauce-one/500.css";
import "@fontsource/open-sauce-one/600.css";
import "@fontsource/open-sauce-one/700.css";

import "../styles/global.css";

const githubUrl = "https://github.com/Trustpoint-Project";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>
      Industrial PKI & Machine Identity Management | Trustpoint Labs
    </title>

    <meta
      name="description"
      content="Vendor-independent industrial PKI engineering, integration, consulting and support. Secure machine identities and automate certificates across OT environments."
    />

    <meta
      name="robots"
      content="index, follow"
    />

    <link
      rel="canonical"
      href="https://trustpoint-labs.com/"
    />

    <link
      rel="icon"
      type="image/png"
      href={trustpointFavicon}
    />

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />

    <meta name="theme-color" content="#004aad" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Trustpoint Labs",
      url: "https://trustpoint-labs.com/",
      sameAs: ["https://github.com/Trustpoint-Project"],
      description: "Vendor-independent engineering, integration, consulting and support for industrial PKI and machine identity management."
    })} />

    <!-- Open Graph -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content="Industrial PKI & Machine Identity Management | Trustpoint Labs"
    />

    <meta
      property="og:description"
      content="Vendor-independent industrial PKI engineering, integration, consulting and support for machine identity and certificate lifecycle management."
    />

    <meta
      property="og:url"
      content="https://trustpoint-labs.com/"
    />

    <meta
      property="og:site_name"
      content="Trustpoint Labs"
    />

    <meta
      property="og:image"
      content="https://trustpoint-labs.com/og-image.png"
    />

    <meta
      property="og:image:width"
      content="1200"
    />

    <meta
      property="og:image:height"
      content="630"
    />

    <meta
      property="og:image:alt"
      content="Trustpoint Labs – Industrial PKI and Machine Identity Management"
    />

  </head>

  <body>

    <!-- ===================================
         HEADER
    ==================================== -->

    <header class="shell">

      <a
        class="logo-link"
        href="/"
        aria-label="Trustpoint Labs"
      >
        <img
          class="logo"
          src={trustpointLogo}
          alt="Trustpoint Labs"
          width="205"
          height="115"
        />
      </a>

      <nav aria-label="Main navigation">

        <a href="#offering">
          Offering
        </a>

        <a href="#why-trustpoint">
          Why Trustpoint
        </a>

        <a href="#open-source">
          Open Source
        </a>

        <a href="#contact">
          Contact
        </a>

        <a
          class="github"
          href={githubUrl}
          target="_blank"
          rel="noreferrer"
        >
          GitHub
          <span>↗︎</span>
        </a>

      </nav>

    </header>


    <main>

      <!-- =================================
           HERO
      ================================== -->

      <section class="hero">

        <div class="hero-content shell">

          <div class="kicker">
            <span class="square"></span>
            INDUSTRIAL MACHINE IDENTITY
          </div>

          <h1>
            Industrial PKI & machine identity.<br />
              <span class="hero-accent">
                Engineered for your environment.
              </span>
          </h1>

          <p class="hero-description">
            Vendor-independent industrial PKI engineering, integration,
            consulting and support for manufacturers, system integrators
            and operators. Secure machine identities, automate certificate
            lifecycles and connect OT systems with existing PKI infrastructure.
          </p>

          <div class="actions">

            <a
              class="button button-primary"
              href="#offering"
            >
              Explore our offering
              <span>↓︎</span>
            </a>

            <a
              class="button button-secondary"
              href="/use-cases/"
            >
              Explore use cases
              <span>→︎</span>
            </a>

          </div>

          <div class="hero-note">
            Open standards · Vendor-independent engineering · Open-source Trustpoint expertise
          </div>

        </div>

      </section>


      <!-- =================================
           PROBLEM / SOLUTION
      ================================== -->

      <section
        class="section shell"
        id="trustpoint"
      >

        <div class="section-label">
          <span class="square"></span>
          WHAT WE SOLVE
        </div>

        <div class="two-col">

          <div>

            <h2>
              Secure machine identities
              in industrial environments.
            </h2>

            <p class="lede">
              Connected factories increasingly depend on secure
              communication, authentication and lifecycle-managed
              digital identities.
            </p>

            <p class="lede">
              Trustpoint Labs designs machine identity and certificate-management
              solutions around your operational requirements and existing PKI.
              Our open-source Trustpoint platform is a key option where local,
              segmented or offline operation is needed.
            </p>

          </div>


          <div>

            <article class="feature">

              <span class="feature-index">
                01
              </span>

              <div>
                <h3>Machine identity</h3>

                <p>
                  Establish trusted identities for industrial
                  devices and machines.
                </p>
              </div>

              <span class="feature-glyph">
                +
              </span>

            </article>


            <article class="feature">

              <span class="feature-index">
                02
              </span>

              <div>
                <h3>Certificate lifecycle</h3>

                <p>
                  Automate enrollment, renewal and lifecycle
                  management for device certificates.
                </p>
              </div>

              <span class="feature-glyph">
                ↔︎
              </span>

            </article>


            <article class="feature">

              <span class="feature-index">
                03
              </span>

              <div>
                <h3>Industrial PKI</h3>

                <p>
                  Connect devices and OT systems to local or
                  enterprise PKI infrastructure.
                </p>
              </div>

              <span class="feature-glyph">
                ↗︎
              </span>

            </article>


            <article class="feature">

              <span class="feature-index">
                04
              </span>

              <div>
                <h3>Device onboarding</h3>

                <p>
                  Support manual brownfield onboarding as well
                  as automated deployment workflows.
                </p>
              </div>

              <span class="feature-glyph">
                →︎
              </span>

            </article>

          </div>

        </div>

      </section>


      <!-- =================================
           OFFERING
      ================================== -->

      <section
        class="offering section"
        id="offering"
      >

        <div class="shell">

          <div class="section-label">
            <span class="square"></span>
            OFFERING
          </div>

          <div class="offering-heading">

            <h2>
              Industrial PKI services
              from design to operation.
            </h2>

            <p class="lede">
              From independent PKI architecture consulting and integration
              to custom engineering and ongoing Trustpoint product support,
              we help turn industrial certificate-management requirements
              into practical deployments.
            </p>

          </div>


          <div class="offering-grid">

            <article class="offering-card">

              <span class="offering-index">
                01
              </span>

              <h3>
                Engineering, Integration & Consulting
              </h3>

              <p>
                Design industrial PKI architectures and integrate devices,
                applications and certificate workflows using Trustpoint
                or suitable existing PKI technologies.
              </p>

              <ul>
                <li>Device onboarding workflows</li>
                <li>CMP / EST integration</li>
                <li>OPC UA / GDS integration</li>
                <li>Custom connectors and plugins</li>
                <li>PKI architecture &amp; industrial security consulting</li>
              </ul>

              <a
                href="/engineering-integration/"
                class="offering-link"
              >
                View details
                <span aria-hidden="true">→︎</span>
              </a>

            </article>


            <article class="offering-card">

              <span class="offering-index">
                02
              </span>

              <h3>
                Support & SLA
              </h3>

              <p>
                Contract-based break/fix support for official Trustpoint
                releases used in production environments.
              </p>

              <ul>
                <li>Business-hours support</li>
                <li>Severity-based response targets</li>
                <li>Troubleshooting</li>
                <li>Upgrade assistance</li>
                <li>Documented product defect analysis</li>
              </ul>

              <a
                href="/support/"
                class="offering-link"
              >
                View support details
                <span aria-hidden="true">→︎</span>
              </a>

            </article>


            <article class="offering-card">

              <span class="offering-index">
                03
              </span>

              <h3>
                OEM & White Label
              </h3>

              <p>
                Use Trustpoint as the technology foundation
                for your own market-facing product.
              </p>

              <ul>
                <li>White-label development</li>
                <li>Embedded or containerized deployment</li>
                <li>Customer-specific maintenance</li>
                <li>Third-level support</li>
                <li>Long-term engineering partnership</li>
              </ul>

              <a href="/oem/" class="offering-link">
                Explore OEM services
                <span aria-hidden="true">→︎</span>
              </a>

            </article>

          </div>

        </div>

      </section>


      <!-- =================================
           WHY TRUSTPOINT
      ================================== -->

      <section
        class="highlight"
        id="why-trustpoint"
      >

        <div class="highlight-inner shell">

          <div class="section-label section-label-light">
            WHY TRUSTPOINT
          </div>

          <div class="highlight-grid">

            <h2>
              Built for
              industrial OT.
            </h2>

            <p>
              Trustpoint is our open-source platform for industrial
              certificate and machine identity management. We combine
              this foundation with vendor-independent engineering and
              existing customer PKI technologies where appropriate.
            </p>

          </div>


          <div class="usp-grid">

            <article class="usp-item">
              <span>01</span>

              <h3>
                OT-native architecture
              </h3>

              <p>
                Built for industrial networks and operating constraints.
              </p>
            </article>


            <article class="usp-item">
              <span>02</span>

              <h3>
                Local, offline & edge deployment
              </h3>

              <p>
                Works without permanent cloud connectivity,
                including air-gapped environments.
              </p>
            </article>


            <article class="usp-item">
              <span>03</span>

              <h3>
                Brownfield & legacy support
              </h3>

              <p>
                Integrates existing devices alongside modern
                automated onboarding.
              </p>
            </article>


            <article class="usp-item">
              <span>04</span>

              <h3>
                Native OPC UA / GDS integration
              </h3>

              <p>
                Supports OPC UA certificate management and
                GDS workflows.
              </p>
            </article>


            <article class="usp-item">
              <span>05</span>

              <h3>
                Open source & auditable
              </h3>

              <p>
                Transparent, reviewable and independently extensible.
              </p>
            </article>


            <article class="usp-item">
              <span>06</span>

              <h3>
                Sovereignty & vendor independence
              </h3>

              <p>
                Open standards and local deployment help reduce
                vendor lock-in.
              </p>
            </article>

          </div>

        </div>

      </section>


      <!-- =================================
           HOW WE WORK
      ================================== -->

      <section class="section shell">

        <div class="section-label">
          <span class="square"></span>
          HOW WE WORK
        </div>

        <div class="process-heading">

          <h2>
            Start small.
            Integrate.
            Scale.
          </h2>

        </div>


        <div class="process-grid">

          <article class="process-item">

            <span class="process-index">
              01
            </span>

            <h3>
              Discovery
            </h3>

            <p>
              We review your devices, network architecture,
              PKI environment and onboarding requirements.
            </p>

          </article>


          <article class="process-item">

            <span class="process-index">
              02
            </span>

            <h3>
              Integration
            </h3>

            <p>
                              We integrate appropriate PKI technologies, configure
                Trustpoint where suitable, and implement connectors,
                enrollment and customer-specific workflows.
            </p>

          </article>


          <article class="process-item">

            <span class="process-index">
              03
            </span>

            <h3>
              Operation
            </h3>

            <p>
                              We hand over deployment documentation and can offer
                separately agreed Trustpoint break/fix support,
                maintenance or follow-on engineering.
            </p>

          </article>

        </div>

      </section>


      <!-- =================================
           DEPLOYMENT MODELS
      ================================== -->

      <section class="deployment section">

        <div class="shell">

          <div class="section-label">
            <span class="square"></span>
            DEPLOYMENT MODELS
          </div>

          <div class="deployment-heading">

            <h2>
              Flexible deployment
              for industrial environments.
            </h2>

          </div>


          <div class="deployment-grid">

            <article class="deployment-card">

              <span>
                01
              </span>

              <h3>
                Local OT Edge
              </h3>

              <p>
                Trustpoint deployed close to machines and devices
                inside the OT environment.
              </p>

            </article>


            <article class="deployment-card">

              <span>
                02
              </span>

              <h3>
                RA Mode
              </h3>

              <p>
                Trustpoint connects industrial OT to an
                authoritative enterprise PKI.
              </p>

            </article>


            <article class="deployment-card">

              <span>
                03
              </span>

              <h3>
                Local CA
              </h3>

              <p>
                Independent certificate authority for isolated,
                segmented or offline environments.
              </p>

            </article>


            <article class="deployment-card">

              <span>
                04
              </span>

              <h3>
                OEM Integration
              </h3>

              <p>
                Trustpoint embedded into a customer's hardware
                or software product.
              </p>

            </article>

          </div>

        </div>

      </section>


      <!-- =================================
           OPEN SOURCE
      ================================== -->

      <section
        class="section shell"
        id="open-source"
      >

        <div class="section-label">
          <span class="square"></span>
          OPEN SOURCE
        </div>

        <div class="two-col">

          <div>

            <h2>
              Open at the core.
            </h2>

          </div>


          <div>

            <p class="open-source-copy">
              Trustpoint is available as open-source software
              under the MIT license. It is a core technology in our
              engineering toolkit, not a prerequisite for every engagement.
            </p>

            <p class="open-source-copy">
              Our vendor-independent approach starts with your existing
              PKI landscape and operational constraints. When Trustpoint
              is the right fit, its open-source foundation enables
              transparent, extensible local machine identity management.
              Commercial Trustpoint support has its own defined scope.
            </p>

            <div class="open-source-actions">

              <a
                class="button button-primary"
                href={githubUrl}
                target="_blank"
                rel="noreferrer"
              >
                Explore Trustpoint on GitHub
                <span>↗︎</span>
              </a>

            </div>

          </div>

        </div>

      </section>


      <!-- =================================
           CONTACT
      ================================== -->

      <section
        class="contact section"
        id="contact"
      >

        <div class="shell">

          <div class="section-label">
            <span class="square"></span>
            GET IN TOUCH
          </div>

          <div class="contact-grid">

            <div class="contact-copy">

              <h2>
                              Let's solve your industrial
              PKI and machine identity challenge.
              </h2>

              <p class="lede">
                Tell us about your certificate management challenges,
                existing PKI, devices or integration requirements.
              </p>

              <div class="contact-next">

                <h3>
                  Start with the right scope.
                </h3>

                <p>
                  We can start with a technical workshop,
                  integration sprint or pilot deployment.
                  Early-stage requirements are completely fine.
                </p>

              </div>

              <p class="contact-email">
                Prefer email?

                <a href="mailto:trustpoint@campus-schwarzwald.de">
                  trustpoint@campus-schwarzwald.de ↗︎
                </a>
              </p>

            </div>


            <div class="contact-panel">

              <h3>
                Discuss your deployment
              </h3>

              <p class="contact-note">
                Fields marked * are required.
              </p>

              <form
                name="contact"
                method="POST"
                action="/success/"
                data-netlify="true"
                class="contact-form"
              >

                <input
                  type="hidden"
                  name="form-name"
                  value="contact"
                />

                <label>
                  Name *

                  <input
                    type="text"
                    name="name"
                    autocomplete="name"
                    placeholder="Your name"
                    required
                  />
                </label>

                <label>
                  Work email *

                  <input
                    type="email"
                    name="email"
                    autocomplete="email"
                    placeholder="you@company.com"
                    required
                  />
                </label>

                <label>
                  Company *

                  <input
                    type="text"
                    name="company"
                    autocomplete="organization"
                    placeholder="Company or organization"
                    required
                  />
                </label>

                <label>
                  What would you like to achieve? *

                  <textarea
                    name="message"
                    rows="5"
                    placeholder="Devices, PKI environment, integration requirements or project idea"
                    required
                  ></textarea>
                </label>

                <label>
                  Number of devices

                  <input
                    type="text"
                    name="devices"
                    placeholder="e.g. 25, 500, 5,000+"
                  />
                </label>

                <label>
                  Deployment environment

                  <input
                    type="text"
                    name="deployment"
                    placeholder="e.g. factory OT, edge appliance, isolated network"
                  />
                </label>

                <button
                  class="contact-submit"
                  type="submit"
                >
                  <span>Send inquiry</span>
                  <span aria-hidden="true">→︎</span>
                </button>

              </form>

            </div>

          </div>

        </div>

      </section>


      <!-- =================================
           FAQ
      ================================== -->

      <section
        class="faq section shell"
        aria-labelledby="faq-label"
      >

        <div
          class="section-label"
          id="faq-label"
        >
          A FEW PRACTICAL DETAILS
        </div>

        <div class="faq-layout">

          <h2>
            Good to know.
          </h2>


          <div class="faq-list">

            <details>

              <summary>
                What is Trustpoint Labs?
                <span aria-hidden="true">+</span>
              </summary>

              <p>
                Trustpoint Labs provides vendor-independent industrial PKI
                consulting, integration and custom engineering, plus
                professional support for the open-source Trustpoint platform.
              </p>

            </details>


            <details>
              <summary>
                Do I need to use Trustpoint to work with Trustpoint Labs?
                <span aria-hidden="true">+</span>
              </summary>
              <p>
                No. Our industrial PKI architecture, integration and consulting
                services can work with existing enterprise PKI and OT systems.
                We recommend Trustpoint where its open-source, locally deployable
                capabilities are a suitable fit for the project.
              </p>
            </details>

            <details>

              <summary>
                What is Trustpoint?
                <span aria-hidden="true">+</span>
              </summary>

              <p>
                Trustpoint is an open-source platform for managing
                digital machine identities in industrial environments.
                It supports local and edge deployment and certificate
                lifecycle workflows for industrial devices.
              </p>

            </details>


            <details>

              <summary>
                Which protocols are supported?
                <span aria-hidden="true">+</span>
              </summary>

              <p>
                Trustpoint supports certificate management and
                enrollment workflows using technologies including
                CMP, EST, REST and OPC UA GDS Push, subject to the
                capabilities of the relevant release and connected devices.
              </p>

            </details>


            <details>

              <summary>
                Can Trustpoint run offline?
                <span aria-hidden="true">+</span>
              </summary>

              <p>
                Yes. Trustpoint supports local and edge deployments
                without permanent cloud connectivity. In isolated
                environments, certificate issuance and renewal require
                a reachable issuing CA within the relevant network.
              </p>

            </details>


            <details>

              <summary>
                Is Trustpoint open source?
                <span aria-hidden="true">+</span>
              </summary>

              <p>
                Yes. Trustpoint is currently distributed under
                the MIT license.
              </p>

            </details>


            <details>

              <summary>
                Do you offer support for production deployments?
                <span aria-hidden="true">+</span>
              </summary>

              <p>
                Yes. Contract-based break/fix support is available for
                eligible official Trustpoint releases. Integration, custom
                engineering and consulting are separately scoped services.
                See our <a href="/support/">Support page</a> for terms.
              </p>

            </details>

          </div>

        </div>

      </section>

    </main>


    <!-- ===================================
         FOOTER
    ==================================== -->

    <footer>

      <div class="footer-inner shell">

        <a
          href="/"
          aria-label="Trustpoint Labs"
        >
          <img
            class="footer-logo"
            src={trustpointLogo}
            alt="Trustpoint Labs"
            width="180"
            height="101"
          />
        </a>


        <div class="footer-links">

          <a href="/engineering-integration/">Engineering &amp; Integration</a>
          <a href="/support/">Support</a>
          <a href="/use-cases/">Use Cases</a>

          <a href="#offering">
            Offering
          </a>

          <a
            href={githubUrl}
            target="_blank"
            rel="noreferrer"
          >
            GitHub ↗︎
          </a>

          <a href="/imprint">
            Imprint
          </a>

          <a href="/privacy">
            Privacy
          </a>

        </div>

      </div>

    </footer>

  </body>
</html>