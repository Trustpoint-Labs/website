---
import trustpointLogo from "../img/trustpoint_labs_logo.svg?url";
import trustpointFavicon from "../img/trustpoint_favicon.png?url";

import "@fontsource/open-sauce-one/400.css";
import "@fontsource/open-sauce-one/500.css";
import "@fontsource/open-sauce-one/600.css";
import "@fontsource/open-sauce-one/700.css";

import "../styles/global.css";

const githubUrl = "https://github.com/Trustpoint-Project";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content="Legal notice for the Trustpoint Labs website."
    />

    <title>Imprint | Trustpoint Labs</title>

    <link
      rel="icon"
      type="image/png"
      href={trustpointFavicon}
    />
  </head>

  <body>

    <header class="shell">
      <a
        class="logo-link"
        href="/"
        aria-label="Trustpoint Labs"
      >
        <img
          class="logo"
          src={trustpointLogo}
          alt="Trustpoint Labs"
        />
      </a>

      <nav aria-label="Main navigation">
        <a href="/">Home</a>

        <a
          class="github"
          href={githubUrl}
          target="_blank"
          rel="noreferrer"
        >
          GitHub
          <span>↗︎</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="legal-page shell">

        <div class="section-label">
          <span class="square"></span>
          LEGAL
        </div>

        <h1 class="legal-title">
          Imprint
        </h1>

        <p class="legal-intro">
          Trustpoint Labs is currently operated as an initiative of
          Campus Schwarzwald gGmbH. Trustpoint Labs GmbH has not yet
          been established as a separate legal entity.
        </p>


        <div class="legal-content">

          <section>
            <h2>Information pursuant to § 5 DDG</h2>

            <p>
              Campus Schwarzwald gGmbH<br />
              Herzog-Eberhard-Straße 56<br />
              72250 Freudenstadt<br />
              Germany
            </p>
          </section>


          <section>
            <h2>Commercial register</h2>

            <p>
              Commercial register: HRB 759245<br />
              Register court: Amtsgericht Stuttgart
            </p>
          </section>


          <section>
            <h2>Represented by</h2>

            <p>
              Stefan Bogenrieder
            </p>
          </section>


          <section>
            <h2>Contact</h2>

            <p>
              Phone:
              <a href="tel:+4974418684900">
                +49 7441 868490-0
              </a>
              <br />

              Email:
              <a href="mailto:info@campus-schwarzwald.de">
                info@campus-schwarzwald.de
              </a>
            </p>
          </section>


          <section>
            <h2>VAT identification number</h2>

            <p>
              VAT identification number according to § 27a
              German VAT Act:
              <br />
              DE310457061
            </p>
          </section>


          <section>
            <h2>Responsible for editorial content</h2>

            <p>
              Stefan Bogenrieder<br />
              Campus Schwarzwald gGmbH<br />
              Herzog-Eberhard-Straße 56<br />
              72250 Freudenstadt
            </p>
          </section>


          <section>
            <h2>Open-source project</h2>

            <p>
              Trustpoint is an open-source software project.
              References to “Trustpoint Labs” on this website currently
              describe the commercialisation and transfer activities
              operated by Campus Schwarzwald gGmbH and do not denote a
              separately incorporated company.
            </p>
          </section>


          <section>
            <h2>Liability for external links</h2>

            <p>
              This website contains links to external third-party
              websites. We have no influence over the content of those
              websites and therefore cannot assume liability for their
              content. The respective provider or operator is responsible
              for the content of linked websites.
            </p>
          </section>


          <section>
            <h2>Consumer dispute resolution</h2>

            <p>
              Campus Schwarzwald gGmbH is neither willing nor obliged
              to participate in dispute resolution proceedings before
              a consumer arbitration board.
            </p>
          </section>

        </div>

      </section>
    </main>


    <footer>
      <div class="footer-inner shell">

        <a href="/" aria-label="Trustpoint Labs">
          <img
            class="footer-logo"
            src={trustpointLogo}
            alt="Trustpoint Labs"
          />
        </a>

        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/imprint">Imprint</a>
          <a href="/privacy">Privacy</a>
        </div>

      </div>
    </footer>

  </body>
</html>