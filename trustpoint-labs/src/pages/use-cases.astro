        margin-top: 7px;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.4;
      }

      .domain-connector {
        position: relative;
        width: 75%;
        height: 34px;
        margin: 0 auto;
      }

      .domain-connector::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 0;
        height: 20px;
        border-left: 1.5px solid rgba(0, 74, 173, 0.5);
      }

      .domain-connector span {
        position: absolute;
        left: 8%;
        right: 8%;
        bottom: 12px;
        border-top: 1.5px solid rgba(0, 74, 173, 0.18);
      }

      .asset-section {
        position: relative;
        z-index: 1;
        margin-top: 3px;
      }

      .asset-heading-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        margin-bottom: 12px;
      }

      .asset-count {
        color: var(--muted);
        font-size: 8px;
        font-weight: 700;
        letter-spacing: 0.09em;
      }

      .asset-grid {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
      }

      .topology-asset {
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr);
        align-items: center;
        gap: 10px;
        min-height: 62px;
        padding: 10px 12px;
        border: 1px solid rgba(0, 74, 173, 0.13);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 6px 16px rgba(31, 55, 86, 0.035);
        transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
      }

      .topology-asset:hover {
        transform: translateY(-2px);
        border-color: rgba(0, 74, 173, 0.36);
        box-shadow: 0 10px 22px rgba(0, 74, 173, 0.065);
      }

      .topology-asset strong {
        font-size: 11px;
        line-height: 1.3;
      }

      .asset-icon {
        display: grid;
        width: 38px;
        height: 38px;
        place-items: center;
        border: 1px solid rgba(0, 74, 173, 0.12);
        border-radius: 10px;
        background: rgba(0, 74, 173, 0.045);
        color: var(--trustpoint-blue);
      }

      .asset-icon svg {
        width: 20px;
        height: 20px;
        fill: none !important;
        stroke: currentColor !important;
        stroke-width: 1.7;
        stroke-linecap: round;
        stroke-linejoin: round;
      }

      .topology-asset.is-compact {
        grid-template-columns: 28px minmax(0, 1fr);
        min-height: 48px;
        padding: 7px 9px;
        box-shadow: none;
      }

      .topology-asset.is-compact .asset-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
      }

      .topology-asset.is-compact .asset-icon svg {
        width: 16px;
        height: 16px;
      }

      .topology-asset.is-compact strong {
        font-size: 9px;
      }

      .other-domains {
        position: relative;
        z-index: 1;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px dashed rgba(0, 74, 173, 0.18);
      }

      .other-domains > div {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
      }

      .ghost-domain {
        display: inline-flex;
        padding: 8px 10px;
        border: 1px dashed rgba(0, 74, 173, 0.22);
        border-radius: 10px;
        color: var(--muted);
        background: rgba(0, 74, 173, 0.025);
        font-size: 9px;
      }

      .deployment-context {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 18px;
        color: var(--muted);
        font-size: 10px;
        line-height: 1.4;
      }

      .deployment-context span {
        color: var(--trustpoint-blue);
        font-size: 16px;
      }

      .operator-trustpoint-stage {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: center;
        margin-top: 24px;
      }

      .operator-bus {
        position: relative;
        z-index: 1;
        width: 82%;
        height: 40px;
        margin: 0 auto;
      }

      .operator-bus::before {
        content: "";
        position: absolute;
        left: 50%;
        top: 0;
        height: 22px;
        border-left: 1.5px solid rgba(0, 74, 173, 0.48);
      }

      .operator-bus span {
        position: absolute;
        left: 7%;
        right: 7%;
        bottom: 10px;
        border-top: 1.5px solid rgba(0, 74, 173, 0.22);
      }

      .operator-domains {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 9px;
      }

      .mini-domain {
        padding: 11px;
        border: 1.5px solid rgba(0, 74, 173, 0.32);
        border-radius: 14px;
        background: rgba(247, 250, 255, 0.86);
      }

      .mini-domain-title {
        padding-bottom: 8px;
        border-bottom: 1px solid rgba(0, 74, 173, 0.09);
      }

      .mini-domain-title strong {
        display: block;
        margin-top: 4px;
        font-size: 10px;
        line-height: 1.25;
      }

      .mini-domain-assets {
        display: grid;
        gap: 6px;
        margin-top: 8px;
      }

      .topology-asset.is-compact.is-text-only {
        min-height: 0;
        padding: 8px 10px;
        border: 1px solid rgba(0, 74, 173, 0.11);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.86);
      }

      .topology-asset.is-compact.is-text-only strong {
        font-size: 10px;
        line-height: 1.3;
      }

      .architecture-note {
        margin: 22px 0 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.6;
      }

      .level-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-top: 48px;
      }

      .level-card,
      .vertical-card {
        min-height: 250px;
        padding: 28px;
        border: 1px solid var(--line);
        border-top: 3px solid var(--trustpoint-blue);
      }

      .level-card > span,
      .vertical-card > span,
      .adjacent-callout > span {
        display: block;
        margin-bottom: 24px;
        color: var(--trustpoint-blue);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
      }

      .level-card h3,
      .vertical-card h3,
      .personalization-materials { margin-top: 16px; }
      .is-personalization .trustpoint-instance { margin-bottom: 0; }
      .personalization-grid h3 {
        margin: 0;
        font-size: 24px;
        line-height: 1.2;
        letter-spacing: -0.025em;
      }

      .level-card p,
      .vertical-card p {
        margin: 14px 0 0;
        color: var(--muted);
        line-height: 1.6;
      }

      .vertical-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-top: 48px;
      }

      .personalization-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(300px, 0.75fr);
        gap: 44px;
        margin-top: 46px;
      }

      .arrow-list {
        margin: 20px 0 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }

      .arrow-list li {
        position: relative;
        padding: 13px 0 13px 24px;
        border-bottom: 1px solid var(--line);
      }

      .arrow-list li::before {
        content: "→︎";
        position: absolute;
        left: 0;
        color: var(--trustpoint-blue);
      }

      .adjacent-callout {
        align-self: start;
        padding: 28px;
        border-left: 4px solid var(--trustpoint-blue);
        background: #f7f9fc;
      }

      .adjacent-callout p {
        margin: 0;
        color: var(--muted);
        line-height: 1.65;
      }

      .capability-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 34px;
        margin: 42px 0 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }

      .capability-list li {
        position: relative;
        padding: 16px 0 16px 24px;
        border-bottom: 1px solid var(--line);
      }

      .capability-list li::before {
        content: "→︎";
        position: absolute;
        left: 0;
        color: var(--trustpoint-blue);
      }

      .use-cases-cta {
        border-bottom: 0;
      }

      .use-cases-cta .button {
        margin-top: 34px;
      }

      @media (max-width: 1000px) {
        .use-cases-hero-grid,
        .use-cases-layout,
        .scenario-panel,
        .personalization-grid {
          grid-template-columns: 1fr;
        }

        .use-cases-sidebar {
          padding-top: 0;
          border-top: 1px solid var(--line);
          border-bottom: 1px solid var(--line);
        }

        .use-cases-sidebar nav {
          position: static;
          display: flex;
          flex-direction: row;
          overflow-x: auto;
          gap: 18px;
          padding: 14px 0;
        }

        .use-cases-sidebar-link {
          flex: 0 0 auto;
          padding: 0;
          border-left: 0;
          border-bottom: 2px solid transparent;
        }

        .use-cases-sidebar-link.is-active {
          border-bottom-color: var(--trustpoint-blue);
        }

        .architecture-panel {
          border-left: 0;
          border-top: 1px solid var(--line);
        }

        .operator-domains {
          grid-template-columns: 1fr;
        }

        .customer-environment {
          padding: 20px;
        }

        .domain-zone {
          padding: 22px;
          border-radius: 22px;
        }

        .trustpoint-instance {
          width: 100%;
        }

      }

      @media (max-width: 760px) {
        .level-grid,
        .vertical-grid,
        .capability-list {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .use-cases-hero {
          padding-block: 58px 64px;
        }

        .use-cases-section {
          padding-block: 64px;
        }

        .scenario-copy,
        .architecture-panel {
          padding: 24px;
        }

        .asset-grid {
          width: 100%;
        }

        .trustpoint-instance {
          width: 100%;
        }

        .asset-grid {
          grid-template-columns: 1fr;
        }

        .topology-asset:last-child:nth-child(odd) {
          grid-column: auto;
          width: 100%;
        }

        .environment-header {
          flex-direction: column;
        }

        .operator-domains {
          grid-template-columns: 1fr;
        }

        .operational-domain-zone,
        .oem-product-zone {
          padding: 16px;
        }

        .trustpoint-instance {
          align-items: flex-start;
          gap: 14px;
          padding: 20px;
        }

        .trustpoint-logo-wrap {
          width: 100%;
          min-width: 0;
          height: auto;
        }

        .trustpoint-instance-logo {
          width: 132px;
        }

        .asset-flow-line {
          left: 16%;
          right: 16%;
        }
      }
    </style>
  </body>
</html>
