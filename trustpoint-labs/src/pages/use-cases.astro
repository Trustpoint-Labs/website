---
import trustpointLogo from "../img/trustpoint_labs_logo.svg?url";
import trustpointProductLogo from "../img/trustpoint_logo.svg?url";
import trustpointFavicon from "../img/trustpoint_favicon.png?url";

import "@fontsource/open-sauce-one/400.css";
import "@fontsource/open-sauce-one/500.css";
import "@fontsource/open-sauce-one/600.css";
import "@fontsource/open-sauce-one/700.css";

import "../styles/global.css";

const githubUrl = "https://github.com/Trustpoint-Project";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Use Cases | Trustpoint Labs</title>

    <meta
      name="description"
      content="Explore Trustpoint use cases across industrial automation, building automation, critical infrastructure and defence — from OEM and white-label integration to domain and operator deployments."
    />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://trustpoint-labs.com/use-cases" />
    <link rel="icon" type="image/png" href={trustpointFavicon} />
  </head>

  <body>
    <header class="shell">
      <a class="logo-link" href="/" aria-label="Trustpoint Labs">
        <img
          class="logo"
          src={trustpointLogo}
          alt="Trustpoint Labs"
          width="205"
          height="115"
        />
      </a>

      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a
          class="github"
          href={githubUrl}
          target="_blank"
          rel="noreferrer"
        >
          GitHub
          <span>↗︎</span>
        </a>
      </nav>
    </header>

    <main class="use-cases-page">
      <section class="use-cases-hero shell" id="overview">
        <div class="section-label">
          <span class="square"></span>
          USE CASES
        </div>

        <div class="use-cases-hero-grid">
          <div>
            <h1>
              Machine identity across products, domains and infrastructure.
            </h1>
          </div>

          <div>
            <p class="use-cases-lede">
              Trustpoint can be embedded into products, integrated into
              operational domains, or connected to operator-wide PKI and
              identity infrastructures.
            </p>

            <p class="use-cases-note">
              Explore how the same machine-identity foundation can be applied
              across industrial automation, building automation, critical
              infrastructure and defence environments.
            </p>
          </div>
        </div>
      </section>

      <div class="use-cases-layout shell">
        <aside class="use-cases-sidebar" aria-label="Use cases page navigation">
          <nav>
            <a href="#overview" class="use-cases-sidebar-link is-active">Overview</a>
            <a href="#explorer" class="use-cases-sidebar-link">Use Case Explorer</a>
            <a href="#integration-levels" class="use-cases-sidebar-link">Integration Levels</a>
            <a href="#verticals" class="use-cases-sidebar-link">Verticals</a>
            <a href="#capabilities" class="use-cases-sidebar-link">Common Capabilities</a>
            <a href="#start-project" class="use-cases-sidebar-link">Start a Project</a>
          </nav>
        </aside>

        <div class="use-cases-content">
          <section id="explorer" class="use-cases-section explorer-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              USE CASE EXPLORER
            </div>

            <h2>Choose your environment. Then choose where Trustpoint fits.</h2>

            <p>
              Select a vertical and integration level to explore a representative
              deployment pattern, typical assets, relevant capabilities and the
              role Trustpoint can play in that environment.
            </p>

            <div class="selector-block">
              <div class="selector-heading">
                <span>01</span>
                <div>
                  <strong>Choose a vertical</strong>
                  <small id="vertical-description">
                    Machines, robots, production cells and plants with heterogeneous OT assets and lifecycle-managed machine identities.
                  </small>
                </div>
              </div>

              <div class="selector-row" role="group" aria-label="Choose a vertical">
                <button class="selector-button vertical-button is-selected" type="button" data-vertical="industrial">Industrial</button>
                <button class="selector-button vertical-button" type="button" data-vertical="building">Building Automation</button>
                <button class="selector-button vertical-button" type="button" data-vertical="critical">Critical Infrastructure</button>
                <button class="selector-button vertical-button" type="button" data-vertical="defence">Defence</button>
              </div>
            </div>

            <div class="selector-block">
              <div class="selector-heading">
                <span>02</span>
                <div>
                  <strong>Choose an integration level</strong>
                  <small>From manufacturing personalization to operator-wide infrastructure.</small>
                </div>
              </div>

              <div class="selector-row" role="group" aria-label="Choose an integration level">
                <button class="selector-button level-button" type="button" data-level="personalization">Device Personalization</button>
                <button class="selector-button level-button" type="button" data-level="oem">OEM / White Label</button>
                <button class="selector-button level-button is-selected" type="button" data-level="domain">Domain Integration</button>
                <button class="selector-button level-button" type="button" data-level="operator">Operator Integration</button>
              </div>
            </div>

            <div class="scenario-panel" aria-live="polite">
              <div class="scenario-copy">
                <div class="scenario-kicker" id="scenario-kicker">INDUSTRIAL · DOMAIN INTEGRATION</div>
                <h3 id="scenario-title">Machine, robot or production-cell identity management</h3>

                <div class="scenario-detail">
                  <span>Typical environment</span>
                  <p id="scenario-environment"></p>
                </div>

                <div class="scenario-detail">
                  <span>Trustpoint role</span>
                  <p id="scenario-role"></p>
                </div>

                <div class="scenario-detail">
                  <span>Typical assets</span>
                  <div class="tag-list" id="scenario-assets"></div>
                </div>

                <div class="scenario-detail">
                  <span>Relevant capabilities</span>
                  <div class="tag-list" id="scenario-capabilities"></div>
                </div>

                <div class="scenario-outcome">
                  <span>Outcome</span>
                  <strong id="scenario-outcome"></strong>
                </div>

                <a id="scenario-cta" class="button button-primary scenario-cta" href="/#contact">
                  Discuss a domain integration
                  <span>→︎</span>
                </a>
              </div>

              <div class="architecture-panel" aria-label="Representative deployment topology">
                <div class="architecture-label">DEPLOYMENT TOPOLOGY</div>
                <div class="deployment-topology">
                  <div class="optional-pki" id="arch-operator">
                    <div class="optional-pki-heading">
                      <span class="optional-pki-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" role="presentation" fill="none" stroke="currentColor">
                          <path d="M12 3 4.5 7v5.5c0 4.8 3.2 7.7 7.5 8.5 4.3-.8 7.5-3.7 7.5-8.5V7L12 3Z" />
                          <path d="M9.5 12.2 11.2 14l3.6-4" />
                        </svg>
                      </span>
                      <div>
                        <span class="optional-badge">OPTIONAL</span>
                        <small>AUTHORITY / CENTRAL PKI</small>
                      </div>
                    </div>
                    <strong id="arch-operator-label">Enterprise PKI / Plant PKI</strong>
                  </div>

                  <div class="optional-connector" aria-hidden="true">
                    <span></span>
                    <i></i>
                  </div>

                  <div
                    id="topology-body"
                    class="topology-body"
                    data-trustpoint-logo={trustpointProductLogo}
                  ></div>
                </div>

                <p class="architecture-note" id="architecture-note">
                  Trustpoint operates inside the selected deployment level. An upstream authority or central PKI is optional.
                </p>
              </div>
            </div>
          </section>

          <section id="integration-levels" class="use-cases-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              INTEGRATION LEVELS
            </div>

            <h2>From device personalization to operational infrastructure.</h2>

            <div class="level-grid">
              <article class="level-card">
                <span>01</span>
                <h3>Device Personalization</h3>
                <p>Provision one device with security material during manufacturing or initial setup: secure boot keys, bootstrap credentials, trust anchors, trust stores, IDevIDs and symmetric keys. These are potential provisioning workflows, not a claim of current feature availability.</p>
              </article>
              <article class="level-card">
                <span>02</span>
                <h3>OEM / White Label</h3>
                <p>
                  Trustpoint becomes part of another vendor's product, appliance
                  or platform and provides machine-identity capabilities as an
                  embedded technology component.
                </p>
              </article>

              <article class="level-card">
                <span>03</span>
                <h3>Domain Integration</h3>
                <p>
                  Trustpoint is deployed inside a defined operational domain such
                  as a machine, robot, production cell, building, substation or
                  vehicle. That domain remains part of the customer's larger
                  operator environment.
                </p>
              </article>

              <article class="level-card">
                <span>04</span>
                <h3>Operator Integration</h3>
                <p>
                  Trustpoint is deployed at operator level and coordinates identity
                  and certificate lifecycle processes across multiple operational
                  domains. An upstream authority or central PKI can be connected
                  where required.
                </p>
              </article>
            </div>
          </section>

          <section id="verticals" class="use-cases-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              VERTICALS
            </div>

            <h2>Different environments. The same identity challenge.</h2>

            <div class="vertical-grid">
              <article class="vertical-card">
                <span>INDUSTRIAL</span>
                <h3>Industrial Automation</h3>
                <p>
                  Machines, robots, production cells and plants with heterogeneous
                  OT assets and lifecycle-managed machine identities.
                </p>
              </article>

              <article class="vertical-card">
                <span>BUILDINGS</span>
                <h3>Building Automation</h3>
                <p>
                  Controllers, gateways, HVAC, access and building systems requiring
                  consistent trust across long-lived and distributed assets.
                </p>
              </article>

              <article class="vertical-card">
                <span>CRITICAL INFRASTRUCTURE</span>
                <h3>Critical Infrastructure</h3>
                <p>
                  Distributed, segmented and security-sensitive environments where
                  identity lifecycle, resilience and controlled trust are essential.
                </p>
              </article>

              <article class="vertical-card">
                <span>DEFENCE</span>
                <h3>Defence</h3>
                <p>
                  Controlled and often disconnected operational environments with
                  high requirements for trust, sovereignty and lifecycle management.
                </p>
              </article>
            </div>
          </section>

          <section id="capabilities" class="use-cases-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              COMMON CAPABILITIES
            </div>

            <h2>Technical building blocks across the use cases.</h2>

            <ul class="capability-list">
              <li>Machine and device identity lifecycle</li>
              <li>Certificate issuance, renewal and revocation</li>
              <li>EST / CMP enrollment</li>
              <li>REST API integration</li>
              <li>OPC UA / GDS</li>
              <li>External PKI / RA integration</li>
              <li>Brownfield onboarding</li>
              <li>Web-UI Automation</li>
              <li>Local, offline and air-gapped deployment</li>
              <li>PKCS#11 / HSM integration where applicable</li>
              <li>Audit logging and lifecycle traceability</li>
            </ul>
          </section>

          <section id="start-project" class="use-cases-section use-cases-cta">
            <div class="section-label compact-label">
              <span class="square"></span>
              START A PROJECT
            </div>

            <h2>Where should Trustpoint fit in your environment?</h2>

            <p>
              Tell us about your devices, operational domain, PKI environment and
              integration requirements. We can help translate the use case into a
              concrete Trustpoint architecture and implementation scope.
            </p>

            <a class="button button-primary" href="/#contact">
              Discuss your use case
              <span>→︎</span>
            </a>
          </section>
        </div>
      </div>
    </main>

    <footer>
      <div class="footer-inner shell">
        <a href="/" aria-label="Trustpoint Labs">
          <img
            class="footer-logo"
            src={trustpointLogo}
            alt="Trustpoint Labs"
            width="180"
            height="101"
          />
        </a>

        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/engineering-integration">Engineering & Integration</a>
          <a href="/support">Support</a>
          <a href="/imprint">Imprint</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>
    </footer>

