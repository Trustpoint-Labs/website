---
import trustpointLogo from "../img/trustpoint_labs_logo.svg?url";
import trustpointFavicon from "../img/trustpoint_favicon.png?url";

import "@fontsource/open-sauce-one/400.css";
import "@fontsource/open-sauce-one/500.css";
import "@fontsource/open-sauce-one/600.css";
import "@fontsource/open-sauce-one/700.css";

import "../styles/global.css";

const githubUrl = "https://github.com/Trustpoint-Project";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Engineering & Integration | Trustpoint Labs</title>

    <meta
      name="description"
      content="Engineering and integration services around Trustpoint, including PKI integration, device onboarding, industrial protocols, custom connectors and customer-specific automation."
    />

    <meta name="robots" content="index, follow" />

    <link
      rel="canonical"
      href="https://trustpoint-labs.com/engineering-integration"
    />

    <link
      rel="icon"
      type="image/png"
      href={trustpointFavicon}
    />
  </head>

  <body>

    <header class="shell">
      <a
        class="logo-link"
        href="/"
        aria-label="Trustpoint Labs"
      >
        <img
          class="logo"
          src={trustpointLogo}
          alt="Trustpoint Labs"
          width="205"
          height="115"
        />
      </a>

      <nav aria-label="Main navigation">
        <a href="/">Home</a>

        <a
          class="github"
          href={githubUrl}
          target="_blank"
          rel="noreferrer"
        >
          GitHub
          <span>↗︎</span>
        </a>
      </nav>
    </header>

    <main class="engineering-page">

      <section class="engineering-hero shell" id="overview">
        <div class="section-label">
          <span class="square"></span>
          ENGINEERING & INTEGRATION
        </div>

        <div class="engineering-hero-grid">
          <div>
            <h1>
              Bring Trustpoint into your environment.
            </h1>
          </div>

          <div>
            <p class="engineering-lede">
              Trustpoint Labs helps organizations design, integrate,
              implement and validate Trustpoint in industrial environments —
              from standard protocol integration to customer-specific
              engineering and device automation.
            </p>

            <p class="engineering-note">
              Engineering & Integration is project-based work around the
              Trustpoint platform. It is distinct from commercial break/fix
              support for existing deployments.
            </p>
          </div>
        </div>
      </section>

      <div class="engineering-layout shell">

        <aside class="engineering-sidebar" aria-label="Engineering page navigation">
          <nav>
            <a href="#overview" class="engineering-sidebar-link is-active">Overview</a>
            <a href="#project-journey" class="engineering-sidebar-link">Project Journey</a>
            <a href="#integration" class="engineering-sidebar-link">Integration</a>
            <a href="#custom-engineering" class="engineering-sidebar-link">Custom Engineering</a>
            <a href="#example-projects" class="engineering-sidebar-link">Example Projects</a>
            <a href="#deliverables" class="engineering-sidebar-link">Deliverables</a>
            <a href="#engineering-vs-support" class="engineering-sidebar-link">Engineering vs. Support</a>
            <a href="#start-project" class="engineering-sidebar-link">Start a Project</a>
          </nav>
        </aside>

        <div class="engineering-content">

          <section id="project-journey" class="engineering-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              PROJECT JOURNEY
            </div>

            <h2>From first assessment to operational handover.</h2>

            <div class="journey-list">
              <article class="journey-item">
                <span class="journey-index">01</span>
                <div>
                  <h3>Assess & Design</h3>
                  <p>
                    We review the target devices, applications, existing PKI,
                    network constraints, protocols and deployment requirements.
                  </p>

                  <h4>Typical deliverables</h4>
                  <ul>
                    <li>Target architecture</li>
                    <li>Integration scope</li>
                    <li>Protocol and interface requirements</li>
                    <li>Implementation plan</li>
                  </ul>
                </div>
              </article>

              <article class="journey-item">
                <span class="journey-index">02</span>
                <div>
                  <h3>Integrate & Implement</h3>
                  <p>
                    We configure Trustpoint, connect systems and devices,
                    implement enrollment workflows and build required custom
                    connectors or automation.
                  </p>

                  <h4>Typical deliverables</h4>
                  <ul>
                    <li>Configured Trustpoint environment</li>
                    <li>Implemented integrations</li>
                    <li>Working enrollment and lifecycle workflows</li>
                    <li>Customer-specific extensions where required</li>
                  </ul>
                </div>
              </article>

              <article class="journey-item">
                <span class="journey-index">03</span>
                <div>
                  <h3>Validate & Deploy</h3>
                  <p>
                    We validate interoperability, review the implementation
                    and prepare the target environment for production use.
                  </p>

                  <h4>Typical deliverables</h4>
                  <ul>
                    <li>Validation results</li>
                    <li>Production configuration</li>
                    <li>Deployment checklist</li>
                    <li>Implementation documentation</li>
                  </ul>
                </div>
              </article>

              <article class="journey-item">
                <span class="journey-index">04</span>
                <div>
                  <h3>Handover & Operate</h3>
                  <p>
                    We document the implemented solution, transfer knowledge
                    and prepare an optional transition into commercial support.
                  </p>

                  <h4>Typical deliverables</h4>
                  <ul>
                    <li>Technical documentation</li>
                    <li>Handover session</li>
                    <li>Operational guidance</li>
                    <li>Optional transition to Trustpoint Labs Support</li>
                  </ul>
                </div>
              </article>
            </div>
          </section>

          <section id="integration" class="engineering-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              INTEGRATION
            </div>

            <h2>Connect Trustpoint to the systems you already operate.</h2>

            <p>
              Integration work focuses on connecting existing devices,
              applications and PKI infrastructure to Trustpoint using
              documented or standardized interfaces.
            </p>

            <div class="capability-grid">
              <article class="capability-card">
                <h3>Enrollment protocols</h3>
                <p>CMP and EST integration for automated certificate enrollment and lifecycle workflows.</p>
              </article>

              <article class="capability-card">
                <h3>REST & API integration</h3>
                <p>Connect applications and automation workflows to Trustpoint through supported APIs.</p>
              </article>

              <article class="capability-card">
                <h3>OPC UA / GDS</h3>
                <p>Integrate Trustpoint into OPC UA certificate-management and GDS-based environments.</p>
              </article>

              <article class="capability-card">
                <h3>External PKI & RA scenarios</h3>
                <p>Connect Trustpoint to an existing authoritative PKI and use it as an OT-facing registration and lifecycle layer.</p>
              </article>

              <article class="capability-card">
                <h3>Device onboarding</h3>
                <p>Implement onboarding and certificate lifecycle workflows for industrial devices.</p>
              </article>

              <article class="capability-card">
                <h3>Brownfield environments</h3>
                <p>Integrate existing devices and segmented environments where modern enrollment interfaces are not always available.</p>
              </article>
            </div>
          </section>

          <section id="custom-engineering" class="engineering-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              CUSTOM ENGINEERING
            </div>

            <h2>Extend Trustpoint where standard interfaces are not enough.</h2>

            <p>
              Custom engineering remains centered on Trustpoint and the
              requirements of a specific deployment. It is used where standard
              configuration and existing interfaces do not fully cover the
              target environment.
            </p>

            <ul class="engineering-list">
              <li>Custom connectors and plugins</li>
              <li>Customer-specific APIs</li>
              <li>Device-specific onboarding logic</li>
              <li>Web-UI Automation profiles</li>
              <li>Proprietary device interfaces</li>
              <li>Customer-specific workflows</li>
              <li>Custom deployment automation</li>
              <li>Trustpoint extensions required for the deployment</li>
            </ul>
          </section>

          <section id="example-projects" class="engineering-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              EXAMPLE PROJECTS
            </div>

            <h2>Typical Trustpoint integration scenarios.</h2>

            <div class="project-grid">
              <article class="project-card">
                <span>01</span>
                <h3>Enterprise PKI Integration</h3>
                <p>
                  Connect Trustpoint to an existing enterprise PKI and use
                  Trustpoint as the OT-facing registration and lifecycle layer.
                </p>
              </article>

              <article class="project-card">
                <span>02</span>
                <h3>Industrial Device Enrollment</h3>
                <p>
                  Implement certificate enrollment and lifecycle workflows for
                  devices using EST, CMP or other supported onboarding mechanisms.
                </p>
              </article>

              <article class="project-card">
                <span>03</span>
                <h3>OPC UA Certificate Management</h3>
                <p>
                  Integrate Trustpoint into OPC UA and GDS-based certificate-management environments.
                </p>
              </article>

              <article class="project-card">
                <span>04</span>
                <h3>Brownfield Device Integration</h3>
                <p>
                  Enable certificate lifecycle management for devices without
                  standardized enrollment interfaces, including device-specific
                  automation and Web-UI Automation.
                </p>
              </article>
            </div>
          </section>

          <section id="deliverables" class="engineering-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              DELIVERABLES
            </div>

            <h2>What an engagement can produce.</h2>

            <p>
              Exact deliverables depend on the agreed project scope, target
              environment and required custom engineering.
            </p>

            <ul class="engineering-list two-column-list">
              <li>Integration architecture</li>
              <li>Configured Trustpoint deployment</li>
              <li>Implemented interfaces and workflows</li>
              <li>Custom connectors or automation</li>
              <li>Validated interoperability</li>
              <li>Deployment documentation</li>
              <li>Operational documentation</li>
              <li>Technical handover</li>
              <li>Optional transition into commercial support</li>
            </ul>
          </section>

          <section id="engineering-vs-support" class="engineering-section">
            <div class="section-label compact-label">
              <span class="square"></span>
              ENGINEERING VS. SUPPORT
            </div>

            <h2>Build and change vs. restore and troubleshoot.</h2>

            <div class="compare-grid">
              <article class="compare-card">
                <h3>Engineering & Integration</h3>
                <p>
                  Designs, adapts, integrates and extends Trustpoint for a customer environment.
                </p>
                <ul>
                  <li>New integrations</li>
                  <li>Deployment projects</li>
                  <li>Device onboarding</li>
                  <li>Custom automation</li>
                  <li>Custom development</li>
                  <li>Architecture work</li>
                </ul>
              </article>

              <article class="compare-card">
                <h3>Commercial Support</h3>
                <p>
                  Troubleshoots and restores documented Trustpoint functionality in supported deployments.
                </p>
                <a class="engineering-inline-link" href="/support">
                  Learn about commercial support
                  <span aria-hidden="true">→︎</span>
                </a>
              </article>
            </div>
          </section>

          <section id="start-project" class="engineering-section engineering-cta">
            <div class="section-label compact-label">
              <span class="square"></span>
              START A PROJECT
            </div>

            <h2>Discuss your integration project.</h2>

            <p>
              Tell us about your devices, PKI environment, interfaces and integration requirements.
            </p>

            <a class="button button-primary" href="/#contact">
              Discuss your project
              <span>→︎</span>
            </a>
          </section>

        </div>
      </div>

    </main>

    <footer>
      <div class="footer-inner shell">
        <a href="/" aria-label="Trustpoint Labs">
          <img
            class="footer-logo"
            src={trustpointLogo}
            alt="Trustpoint Labs"
            width="180"
            height="101"
          />
        </a>

        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/support">Support</a>
          <a href="/imprint">Imprint</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      const links = Array.from(document.querySelectorAll('.engineering-sidebar-link'));
      const sections = links
        .map((link) => document.querySelector(link.getAttribute('href')))
        .filter(Boolean);

      const setActive = (id) => {
        links.forEach((link) => {
          link.classList.toggle('is-active', link.getAttribute('href') === `#${id}`);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

          if (visible.length > 0) {
            setActive(visible[0].target.id);
          }
        },
        {
          rootMargin: '-18% 0px -65% 0px',
          threshold: [0, 0.1, 0.25, 0.5, 0.75]
        }
      );

      sections.forEach((section) => observer.observe(section));
    </script>

    <style>
      .engineering-page {
        border-top: 1px solid var(--line);
      }

      .engineering-hero {
        padding-block: 86px 92px;
      }

      .engineering-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: clamp(56px, 8vw, 120px);
        align-items: end;
      }

      .engineering-hero h1 {
        margin: 0;
        max-width: 900px;
        font-size: clamp(52px, 6.4vw, 92px);
        line-height: 0.98;
        letter-spacing: -0.045em;
        font-weight: 600;
      }

      .engineering-lede {
        margin: 0;
        color: var(--black);
        font-size: 21px;
        line-height: 1.6;
      }

      .engineering-note {
        margin: 28px 0 0;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.6;
      }

      .engineering-layout {
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
        gap: clamp(48px, 7vw, 104px);
        border-top: 1px solid var(--line);
      }

      .engineering-sidebar {
        position: relative;
        padding-top: 58px;
      }

      .engineering-sidebar nav {
        position: sticky;
        top: 28px;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }

      .engineering-sidebar-link {
        display: block;
        padding: 11px 0 11px 16px;
        border-left: 2px solid var(--line);
        color: var(--muted);
        font-size: 14px;
        line-height: 1.35;
      }

      .engineering-sidebar-link:hover,
      .engineering-sidebar-link:focus-visible,
      .engineering-sidebar-link.is-active {
        color: var(--trustpoint-blue);
        border-left-color: var(--trustpoint-blue);
      }

      .engineering-sidebar-link.is-active {
        font-weight: 600;
      }

      .engineering-content {
        min-width: 0;
      }

      .engineering-section {
        padding-block: 88px;
        border-bottom: 1px solid var(--line);
        scroll-margin-top: 36px;
      }

      .compact-label {
        margin-bottom: 26px;
      }

      .engineering-section h2 {
        max-width: 900px;
        margin: 0;
        font-size: clamp(38px, 4.7vw, 62px);
        line-height: 1.02;
      }

      .engineering-section > p {
        max-width: 820px;
        margin: 26px 0 0;
        color: var(--muted);
        font-size: 18px;
        line-height: 1.65;
      }

      .journey-list {
        margin-top: 52px;
        border-top: 1px solid var(--black);
      }

      .journey-item {
        display: grid;
        grid-template-columns: 72px minmax(0, 1fr);
        gap: 28px;
        padding: 34px 0;
        border-bottom: 1px solid var(--line);
      }

      .journey-index {
        color: var(--trustpoint-blue);
        font-size: 12px;
        font-weight: 600;
      }

      .journey-item h3,
      .capability-card h3,
      .project-card h3,
      .compare-card h3 {
        margin: 0;
        font-size: 24px;
        line-height: 1.2;
        letter-spacing: -0.025em;
      }

      .journey-item p,
      .capability-card p,
      .project-card p,
      .compare-card p {
        margin: 12px 0 0;
        color: var(--muted);
        line-height: 1.6;
      }

      .journey-item h4 {
        margin: 22px 0 0;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .journey-item ul,
      .compare-card ul {
        margin: 12px 0 0;
        padding-left: 18px;
      }

      .journey-item li,
      .compare-card li {
        margin: 5px 0;
      }

      .capability-grid,
      .project-grid,
      .compare-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-top: 48px;
      }

      .capability-card,
      .project-card,
      .compare-card {
        min-height: 220px;
        padding: 28px;
        border: 1px solid var(--line);
        border-top: 3px solid var(--trustpoint-blue);
        background: #fff;
      }

      .project-card > span {
        display: block;
        margin-bottom: 28px;
        color: var(--trustpoint-blue);
        font-size: 12px;
        font-weight: 600;
      }

      .engineering-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 32px;
        margin: 42px 0 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--line);
      }

      .engineering-list li {
        position: relative;
        padding: 16px 0 16px 24px;
        border-bottom: 1px solid var(--line);
      }

      .engineering-list li::before {
        content: "→︎";
        position: absolute;
        left: 0;
        color: var(--trustpoint-blue);
      }

      .two-column-list {
        max-width: 980px;
      }

      .engineering-inline-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        color: var(--trustpoint-blue);
        font-size: 14px;
        font-weight: 600;
      }

      .engineering-inline-link:hover,
      .engineering-inline-link:focus-visible {
        text-decoration: underline;
      }

      .engineering-cta {
        border-bottom: 0;
      }

      .engineering-cta .button {
        margin-top: 34px;
      }

      @media (max-width: 920px) {
        .engineering-hero-grid,
        .engineering-layout {
          grid-template-columns: 1fr;
        }

        .engineering-sidebar {
          padding-top: 0;
          border-top: 1px solid var(--line);
          border-bottom: 1px solid var(--line);
        }

        .engineering-sidebar nav {
          position: static;
          display: flex;
          flex-direction: row;
          overflow-x: auto;
          gap: 18px;
          padding: 14px 0;
        }

        .engineering-sidebar-link {
          flex: 0 0 auto;
          padding: 0;
          border-left: 0;
          border-bottom: 2px solid transparent;
        }

        .engineering-sidebar-link.is-active {
          border-bottom-color: var(--trustpoint-blue);
        }

        .capability-grid,
        .project-grid,
        .compare-grid,
        .engineering-list {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .engineering-hero {
          padding-block: 58px 64px;
        }

        .engineering-section {
          padding-block: 64px;
        }

        .journey-item {
          grid-template-columns: 1fr;
          gap: 12px;
        }
      }
    </style>

  </body>
</html>
