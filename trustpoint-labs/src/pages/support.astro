---
import trustpointLogo from "../img/trustpoint_labs_logo.svg?url";
import trustpointFavicon from "../img/trustpoint_favicon.png?url";

import "@fontsource/open-sauce-one/400.css";
import "@fontsource/open-sauce-one/500.css";
import "@fontsource/open-sauce-one/600.css";
import "@fontsource/open-sauce-one/700.css";

import "../styles/global.css";

const githubUrl = "https://github.com/Trustpoint-Project";
const supportEmail = "support@trustpoint-labs.com";
const securityEmail = "security@trustpoint-labs.com";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Commercial Support | Trustpoint Labs</title>

    <meta
      name="description"
      content="Commercial break/fix support for official Trustpoint releases from version 1.0.0 onward, including support scope, severity levels, response targets and case handling."
    />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://trustpoint-labs.com/support/" />
    <link rel="icon" type="image/png" href={trustpointFavicon} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Commercial Support | Trustpoint Labs" />
    <meta
      property="og:description"
      content="Commercial technical support for Trustpoint production environments."
    />
    <meta property="og:url" content="https://trustpoint-labs.com/support/" />
    <meta property="og:site_name" content="Trustpoint Labs" />
    <meta property="og:image" content="https://trustpoint-labs.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Trustpoint Labs – Commercial Support" />

    <style>
      .support-hero {
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        padding-block: 88px 72px;
      }

      .support-hero h1 {
        max-width: 980px;
        font-size: clamp(52px, 6.4vw, 92px);
        line-height: 0.98;
      }

      .support-hero p {
        max-width: 780px;
        margin: 30px 0 0;
        color: var(--muted);
        font-size: 20px;
        line-height: 1.6;
      }

      .support-layout {
        display: grid;
        grid-template-columns: minmax(0, 250px) minmax(0, 1fr);
        gap: clamp(40px, 8vw, 120px);
      }

      .support-index {
        align-self: start;
        position: sticky;
        top: 32px;
      }

      .support-index p {
        margin: 0 0 18px;
        color: var(--trustpoint-blue);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .support-index a {
        display: block;
        padding: 9px 0 9px 14px;
        border-left: 2px solid transparent;
        color: var(--muted);
        font-size: 14px;
        transition: color 160ms ease, border-color 160ms ease;
      }

      .support-index a:hover,
      .support-index a:focus-visible,
      .support-index a.is-active {
        border-left-color: var(--trustpoint-blue);
        color: var(--trustpoint-blue);
      }

      .support-index a.is-active {
        font-weight: 600;
      }

      .support-content {
        min-width: 0;
      }

      .support-section {
        padding-block: 64px;
        border-top: 1px solid var(--line);
        scroll-margin-top: 32px;
      }

      .support-section:first-child {
        border-top: 0;
        padding-top: 0;
      }

      .support-section h2 {
        font-size: clamp(36px, 4vw, 56px);
        line-height: 1.04;
      }

      .support-section h3 {
        margin: 34px 0 10px;
        font-size: 22px;
        line-height: 1.25;
      }

      .support-section p,
      .support-section li {
        max-width: 820px;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.7;
      }

      .support-section ul {
        margin: 14px 0 0;
        padding-left: 22px;
      }

      .support-section li + li {
        margin-top: 6px;
      }

      .support-callout {
        margin-top: 30px;
        padding: 24px;
        border-left: 4px solid var(--trustpoint-blue);
        background: #f7f9fc;
      }

      .support-callout p {
        margin: 0;
        color: var(--black);
        font-size: 18px;
        font-weight: 600;
      }

      .at-a-glance {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        margin-top: 42px;
        border-top: 1px solid var(--line);
        border-left: 1px solid var(--line);
      }

      .at-a-glance article {
        min-height: 170px;
        padding: 22px;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .at-a-glance span {
        display: block;
        margin-bottom: 18px;
        color: var(--trustpoint-blue);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
      }

      .at-a-glance strong {
        display: block;
        font-size: 18px;
        line-height: 1.35;
      }

      .at-a-glance small {
        display: block;
        margin-top: 8px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.5;
      }

      .severity-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        margin-top: 34px;
        border-top: 1px solid var(--line);
        border-left: 1px solid var(--line);
      }

      .severity-card {
        min-height: 300px;
        padding: 26px;
        border-right: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
      }

      .severity-card .severity-label {
        color: var(--trustpoint-blue);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
      }

      .severity-card h3 {
        margin-top: 14px;
      }

      .severity-card .target {
        margin-top: 22px;
        color: var(--black);
        font-size: 16px;
        font-weight: 700;
      }

      .response-table {
        width: 100%;
        margin-top: 28px;
        border-collapse: collapse;
      }

      .response-table th,
      .response-table td {
        padding: 16px 18px;
        border: 1px solid var(--line);
        text-align: left;
        vertical-align: top;
      }

      .response-table th {
        background: #f7f9fc;
        font-size: 13px;
      }

      .response-table td {
        font-size: 15px;
      }

      .support-email {
        display: inline-block;
        margin-top: 18px;
        color: var(--trustpoint-blue);
        font-size: 20px;
        font-weight: 600;
      }

      .support-cta {
        margin-top: 36px;
        padding: 34px;
        border: 1px solid var(--black);
      }

      .support-cta h3 {
        margin-top: 0;
        font-size: 28px;
      }

      .support-cta p {
        margin-bottom: 0;
      }

      @media (max-width: 1100px) {
        .at-a-glance {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .severity-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 900px) {
        .support-layout {
          grid-template-columns: 1fr;
        }

        .support-index {
          display: none;
        }
      }

      @media (max-width: 720px) {
        .support-hero {
          padding-block: 64px 54px;
        }

        .support-hero p {
          font-size: 18px;
        }

        .at-a-glance {
          grid-template-columns: 1fr;
        }

        .support-section {
          padding-block: 50px;
        }

        .response-table,
        .response-table tbody,
        .response-table tr,
        .response-table td {
          display: block;
          width: 100%;
        }

        .response-table thead {
          display: none;
        }

        .response-table tr + tr {
          margin-top: 12px;
        }
      }
    </style>
  </head>

  <body>
    <header class="shell">
      <a class="logo-link" href="/" aria-label="Trustpoint Labs">
        <img class="logo" src={trustpointLogo} alt="Trustpoint Labs" width="205" height="115" />
      </a>

      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a class="github" href={githubUrl} target="_blank" rel="noreferrer">
          GitHub <span>↗︎</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="support-hero">
        <div class="shell">
          <div class="kicker">
            <span class="square"></span>
            COMMERCIAL SUPPORT
          </div>

          <h1>
            Professional support.<br />
            <span class="hero-accent">Defined expectations.</span>
          </h1>

          <p>
            Trustpoint Labs provides commercial break/fix support for organizations operating Trustpoint in production and business-critical environments. Support is available under an active Trustpoint Labs support agreement.
          </p>

          <div class="at-a-glance" aria-label="Support at a glance">
            <article>
              <span>SUPPORTED VERSIONS</span>
              <strong>Official releases from v1.0.0 onward</strong>
            </article>
            <article>
              <span>SUPPORT HOURS</span>
              <strong>Mon–Fri, 09:00–17:00</strong>
              <small>Europe/Berlin, excluding German public holidays</small>
            </article>
            <article>
              <span>SEVERITY 1</span>
              <strong>4 business hours</strong>
              <small>Target initial response</small>
            </article>
            <article>
              <span>SEVERITY 2</span>
              <strong>1 business day</strong>
              <small>Target initial response</small>
            </article>
            <article>
              <span>SEVERITY 3</span>
              <strong>2 business days</strong>
              <small>Target initial response</small>
            </article>
          </div>
        </div>
      </section>

      <section class="section shell">
        <div class="support-layout">
          <aside class="support-index" aria-label="Support handbook index">
            <p>SUPPORT HANDBOOK</p>
            <a href="#general-information">General information</a>
            <a href="#scope">Support scope</a>
            <a href="#supported">What is supported</a>
            <a href="#not-supported">What is not supported</a>
            <a href="#versions">Supported versions</a>
            <a href="#severity">Severity levels</a>
            <a href="#response">Response targets</a>
            <a href="#hours">Support hours</a>
            <a href="#case">Opening a support case</a>
            <a href="#responsibilities">Customer responsibilities</a>
            <a href="#security">Security vulnerabilities</a>
            <a href="#professional-services">Professional Services</a>
          </aside>

          <div class="support-content">
            <section class="support-section" id="general-information">
              <div class="section-label"><span class="square"></span>GENERAL INFORMATION</div>
              <h2>Commercial technical support for Trustpoint.</h2>
              <p>
                Trustpoint Labs provides commercial support for organizations operating Trustpoint in production and business-critical environments. Support is available to customers with an active Trustpoint Labs support agreement and focuses on restoring documented Trustpoint functionality when technical problems occur.
              </p>
              <p>
                Commercial support follows a break/fix model. It does not include consulting, system design, integration projects, custom development, training or other professional services.
              </p>
              <div class="support-callout">
                <p>Trustpoint Labs Support helps restore documented Trustpoint functionality.</p>
              </div>
            </section>

            <section class="support-section" id="scope">
              <div class="section-label"><span class="square"></span>SUPPORT SCOPE</div>
              <h2>Focused on product operation.</h2>
              <p>
                Support covers technical problems affecting official Trustpoint releases where the software does not operate as documented or expected. Our support engineers assist with problem determination, troubleshooting and defect analysis related to Trustpoint itself.
              </p>
              <p>
                Where appropriate, Trustpoint Labs may request that a customer update to a newer supported Trustpoint release before further troubleshooting. Support does not include the design, implementation or modification of customer environments.
              </p>
            </section>

            <section class="support-section" id="supported">
              <div class="section-label"><span class="square"></span>WHAT IS SUPPORTED</div>
              <h2>Break/fix support for documented Trustpoint functionality.</h2>

              <h3>Product functionality</h3>
              <p>Problems where Trustpoint does not behave according to its documentation or expected product functionality.</p>
              <ul>
                <li>Trustpoint services failing unexpectedly</li>
                <li>Certificate lifecycle operations not completing correctly</li>
                <li>Certificate issuance, renewal or revocation failures</li>
                <li>CA or RA functionality not behaving as documented</li>
                <li>Errors in Trustpoint workflows or the user interface</li>
                <li>Documented API functionality not operating correctly</li>
              </ul>

              <h3>Installation troubleshooting</h3>
              <p>
                Support includes troubleshooting installation problems where the customer has followed the official Trustpoint installation documentation. Support does not include performing a new installation or designing the deployment architecture.
              </p>

              <h3>Configuration troubleshooting</h3>
              <p>
                Support includes identifying errors within documented Trustpoint configuration options and determining whether a problem originates from Trustpoint or from the surrounding environment.
              </p>

              <h3>Updates and upgrades</h3>
              <p>
                Support includes troubleshooting problems occurring during or after an officially documented Trustpoint update or upgrade.
              </p>

              <h3>Protocols and interfaces</h3>
              <p>
                Support includes troubleshooting Trustpoint implementations of officially supported interfaces and protocols when they do not behave as documented. Depending on the Trustpoint release, this may include EST, CMP, REST APIs, OPC UA GDS functionality, and certificate or trust-store management interfaces.
              </p>
              <p>
                Support covers the Trustpoint side of these interfaces. Configuration, implementation or troubleshooting of third-party systems is outside the standard support scope.
              </p>

              <h3>Defect reports</h3>
              <p>
                Reproducible defects in supported Trustpoint releases may be escalated to Trustpoint engineering. Where a software change is required, Trustpoint Labs may provide a workaround, recommend an update, or make a correction available through a future Trustpoint release.
              </p>

              <h3>Log and error analysis</h3>
              <p>
                Trustpoint Labs Support may analyze relevant Trustpoint logs, error messages and diagnostic information to identify the cause of a reported problem.
              </p>
            </section>

            <section class="support-section" id="not-supported">
              <div class="section-label"><span class="square"></span>WHAT IS NOT SUPPORTED</div>
              <h2>Support is not a substitute for engineering or consulting.</h2>

              <h3>Installation and implementation services</h3>
              <ul>
                <li>Performing a new Trustpoint installation</li>
                <li>Deploying Trustpoint into a customer environment</li>
                <li>Designing a production deployment</li>
                <li>Setting up operating systems, containers or infrastructure</li>
                <li>Configuring customer networks or firewalls</li>
              </ul>

              <h3>Architecture and design</h3>
              <ul>
                <li>PKI architectures and certificate-management concepts</li>
                <li>OT security or network architectures</li>
                <li>Trust models</li>
                <li>Availability or disaster-recovery concepts</li>
              </ul>

              <h3>Integration projects</h3>
              <ul>
                <li>Integration with third-party PKI products</li>
                <li>Configuration of external CAs</li>
                <li>Integration with customer applications or identity-management systems</li>
                <li>Integration with industrial devices or network infrastructure</li>
                <li>Creation of customer-specific deployment workflows</li>
              </ul>
              <p>
                Support may assist in determining whether Trustpoint itself is functioning correctly at an integration boundary.
              </p>

              <h3>Third-party products and infrastructure</h3>
              <p>
                Trustpoint Labs does not provide standard support for third-party software, hardware or infrastructure, including operating systems, hypervisors, container platforms, unsupported databases, firewalls, switches, routers, HSM administration, external PKI products, OPC UA servers or clients, industrial controllers and other connected devices.
              </p>

              <h3>Device integration</h3>
              <ul>
                <li>Device-specific onboarding implementations</li>
                <li>Custom certificate deployment mechanisms</li>
                <li>Device configuration</li>
                <li>Development of Web-UI Automation profiles</li>
                <li>Adaptation of Trustpoint to proprietary device interfaces</li>
              </ul>

              <h3>Custom development</h3>
              <ul>
                <li>New Trustpoint features</li>
                <li>Custom software or scripts</li>
                <li>Customer-specific code, APIs or extensions</li>
                <li>Bespoke workflows</li>
              </ul>

              <h3>Modified versions and forks</h3>
              <p>
                Standard support does not cover third-party forks, modified Trustpoint source code, customer-specific builds, unreleased development branches or individual development commits unless separately agreed.
              </p>

              <h3>Consulting and training</h3>
              <ul>
                <li>Consulting</li>
                <li>Security assessments or architecture workshops</li>
                <li>Penetration testing or compliance assessments</li>
                <li>Training</li>
                <li>Project engineering</li>
                <li>Performance optimization projects</li>
              </ul>
            </section>

            <section class="support-section" id="versions">
              <div class="section-label"><span class="square"></span>SUPPORTED VERSIONS</div>
              <h2>Official Trustpoint releases from v1.0.0 onward.</h2>
              <p>
                Commercial Trustpoint Labs Support is available for official Trustpoint releases from version 1.0.0 onward. Support applies only to official releases published by the Trustpoint project.
              </p>
              <p>
                Development branches, unofficial builds, forks and modified Trustpoint versions are outside the standard support scope unless explicitly included in a separate agreement.
              </p>
              <p>
                Trustpoint Labs may recommend or require an update to a newer Trustpoint release where a known issue has already been resolved or where continued diagnosis on an older release is not reasonable.
              </p>
            </section>

            <section class="support-section" id="severity">
              <div class="section-label"><span class="square"></span>SEVERITY LEVELS</div>
              <h2>Severity reflects technical and operational impact.</h2>

              <div class="severity-grid">
                <article class="severity-card">
                  <span class="severity-label">SEVERITY 1</span>
                  <h3>Critical</h3>
                  <p>
                    A critical production system is unavailable or essential Trustpoint functionality is unusable, with significant operational impact and no reasonable workaround.
                  </p>
                  <p class="target">Target initial response: 4 business hours</p>
                </article>

                <article class="severity-card">
                  <span class="severity-label">SEVERITY 2</span>
                  <h3>Major</h3>
                  <p>
                    Important Trustpoint functionality is significantly impaired, but the system remains partially usable or a reasonable workaround is available.
                  </p>
                  <p class="target">Target initial response: 1 business day</p>
                </article>

                <article class="severity-card">
                  <span class="severity-label">SEVERITY 3</span>
                  <h3>Standard</h3>
                  <p>
                    A non-critical defect, configuration problem or technical question relating to supported Trustpoint functionality with limited operational impact.
                  </p>
                  <p class="target">Target initial response: 2 business days</p>
                </article>
              </div>
            </section>

            <section class="support-section" id="response">
              <div class="section-label"><span class="square"></span>RESPONSE TARGETS</div>
              <h2>Initial response, not guaranteed resolution time.</h2>
              <p>
                Response targets refer to the time between receipt of a valid support request and the initial response from Trustpoint Labs Support.
              </p>

              <table class="response-table">
                <thead>
                  <tr>
                    <th>Severity</th>
                    <th>Target initial response</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Severity 1 — Critical</td>
                    <td>4 business hours</td>
                  </tr>
                  <tr>
                    <td>Severity 2 — Major</td>
                    <td>1 business day</td>
                  </tr>
                  <tr>
                    <td>Severity 3 — Standard</td>
                    <td>2 business days</td>
                  </tr>
                </tbody>
              </table>

              <p>
                Resolution time depends on factors including problem complexity, reproducibility, availability of diagnostic information, customer response times, required software changes and dependencies on third-party systems.
              </p>
            </section>

            <section class="support-section" id="hours">
              <div class="section-label"><span class="square"></span>SUPPORT HOURS</div>
              <h2>Business-hours support in Europe/Berlin.</h2>
              <p><strong>Monday–Friday, 09:00–17:00 Europe/Berlin</strong></p>
              <p>
                German public holidays are excluded. Response targets are measured only during these support hours. A case submitted outside business hours begins accruing support time at the start of the next support period.
              </p>
              <p>Trustpoint Labs does not currently provide standard 24/7 support.</p>
            </section>

            <section class="support-section" id="case">
              <div class="section-label"><span class="square"></span>OPENING A SUPPORT CASE</div>
              <h2>Send complete technical information from the start.</h2>
              <p>
                Customers with an active Trustpoint Labs support agreement can open a support case by email:
              </p>
              <a class="support-email" href={`mailto:${supportEmail}`}>{supportEmail} ↗︎</a>

              <h3>Please include</h3>
              <ul>
                <li>Company name and technical contact</li>
                <li>Trustpoint version</li>
                <li>Deployment type and relevant environment information</li>
                <li>Requested severity</li>
                <li>Concise problem description</li>
                <li>Expected and actual behavior</li>
                <li>Business impact</li>
                <li>Relevant logs and error messages</li>
                <li>Steps to reproduce, where available</li>
                <li>Recent changes to the environment</li>
                <li>Known workaround, if any</li>
              </ul>

              <div class="support-callout">
                <p>Please do not send passwords, private keys or other secrets by email.</p>
              </div>
            </section>

            <section class="support-section" id="responsibilities">
              <div class="section-label"><span class="square"></span>CUSTOMER RESPONSIBILITIES</div>
              <h2>Effective support requires cooperation.</h2>
              <p>Customers are expected to:</p>
              <ul>
                <li>Provide a technically competent contact person</li>
                <li>Provide sufficient information to reproduce and diagnose the problem</li>
                <li>Provide relevant logs and error information</li>
                <li>Maintain appropriate backups and recovery procedures</li>
                <li>Apply recommended updates, patches or configuration changes where reasonably required</li>
                <li>Cooperate in determining whether the root cause lies within Trustpoint or the surrounding environment</li>
                <li>Respond to requests for additional diagnostic information</li>
                <li>Maintain the security of their systems and credentials</li>
              </ul>
              <p>
                Remote access to customer systems is not included by default and must be separately agreed where required. The customer remains responsible for operating and administering its infrastructure.
              </p>
            </section>

            <section class="support-section" id="security">
              <div class="section-label"><span class="square"></span>SECURITY VULNERABILITIES</div>
              <h2>Report suspected vulnerabilities privately.</h2>
              <p>
                Suspected security vulnerabilities in Trustpoint should not be submitted as normal support cases or published through public GitHub issues.
              </p>
              <a class="support-email" href={`mailto:${securityEmail}`}>{securityEmail} ↗︎</a>
              <p>
                This includes suspected authentication or authorization bypasses, privilege escalation, unintended disclosure of sensitive information, cryptographic implementation weaknesses, or vulnerabilities affecting the confidentiality, integrity or availability of Trustpoint.
              </p>
              <p>
                Please provide sufficient technical information to reproduce and evaluate the issue. Do not include private keys, passwords or production secrets unless a secure transfer method has been agreed.
              </p>
            </section>

            <section class="support-section" id="professional-services">
              <div class="section-label"><span class="square"></span>PROFESSIONAL SERVICES</div>
              <h2>Need more than break/fix support?</h2>
              <p>
                Requests outside the standard support scope can be handled separately through Trustpoint Labs Professional Services. This may include deployment, PKI and machine-identity architecture, integration engineering, device integration, custom automation, Web-UI Automation profiles, custom development, workshops, training and security consulting.
              </p>
              <div class="support-cta">
                <h3>Commercial support for production Trustpoint environments.</h3>
                <p>
                  Trustpoint Labs commercial support is available under an individual support agreement. Contact us to discuss your requirements.
                </p>
                <a class="support-email" href={`mailto:${supportEmail}`}>{supportEmail} ↗︎</a>
              </div>
            </section>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner shell">
        <a href="/" aria-label="Trustpoint Labs">
          <img class="footer-logo" src={trustpointLogo} alt="Trustpoint Labs" width="180" height="101" />
        </a>

        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/imprint">Imprint</a>
          <a href="/privacy">Privacy</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      const supportLinks = Array.from(
        document.querySelectorAll('.support-index a[href^="#"]')
      );
      const supportSections = supportLinks
        .map((link) => document.querySelector(link.getAttribute('href')))
        .filter(Boolean);

      const setActiveSection = (id) => {
        supportLinks.forEach((link) => {
          const active = link.getAttribute('href') === `#${id}`;
          link.classList.toggle('is-active', active);
          if (active) {
            link.setAttribute('aria-current', 'location');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

          if (visible.length > 0) {
            setActiveSection(visible[0].target.id);
          }
        },
        {
          rootMargin: '-15% 0px -70% 0px',
          threshold: 0
        }
      );

      supportSections.forEach((section) => observer.observe(section));

      supportLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const id = link.getAttribute('href').slice(1);
          setActiveSection(id);
        });
      });

      if (supportSections.length > 0) {
        const initialId = window.location.hash
          ? window.location.hash.slice(1)
          : supportSections[0].id;
        setActiveSection(initialId);
      }
    </script>
  </body>
</html>
